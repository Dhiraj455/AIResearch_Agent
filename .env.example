OPENAI_API_KEY=your_key_here
MODEL=gpt-4.1-mini

GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Optional: without it (or if Redis is down) an in-process cache is used
REDIS_URL=redis://localhost:6379/0
# Skeptic quorum: models that vote on every claim ("openai:<model>" uses OPENAI_API_KEY)
VERIFIER_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash
# Re-investigate while more than this share of the latest claims is refuted
MAX_REFUTED_RATIO=0.3
# GEMINI_MODEL_FAST=gemini-2.0-flash  # optional: faster model for chat follow-ups
# --- Free local models via Ollama (instead of Gemini/OpenAI keys) ---
# GEMINI_MODEL=openai:qwen2.5:7b
# OPENAI_BASE_URL=http://localhost:11434/v1
# VERIFIER_MODELS=openai:qwen2.5:7b,openai:llama3.1:8b,openai:mistral:7b
# LLM_TIMEOUT_S=600
# LLM_CONCURRENCY=2
